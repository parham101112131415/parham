# --- Telegram ---
BOT_TOKEN=
OWNER_ID=

# --- AI backend: "bridge" (opencode serve, default) or "openai" ---
AI_BACKEND=bridge
OPENCODE_SERVE_URL=http://127.0.0.1:4096
OPENCODE_MODEL=opencode/muse-spark-1.3
OPENCODE_FALLBACK_MODEL=opencode/mimo-v2.5-free

# --- OpenAI fallback (only used when AI_BACKEND=openai, e.g. Railway standalone) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Runtime ---
DATA_DIR=./data
MODE=polling
PORT=8080
WEBHOOK_URL=

# --- Dashboard (Parham panel, served on $PORT) ---
DASHBOARD_USER=admin
DASHBOARD_PASS=changeme

# --- Workers ---
TZ=Asia/Tehran
