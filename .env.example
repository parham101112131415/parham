# --- Telegram ---
BOT_TOKEN=
OWNER_ID=

# --- AI backend: "bridge" (opencode serve, default) or "openai" ---
AI_BACKEND=bridge
OPENCODE_SERVE_URL=http://127.0.0.1:4096
OPENCODE_MODEL=opencode/muse-spark-1.3

# --- OpenAI fallback (bridge failure only) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Runtime (Railway Volume mounted at /data; PORT set by Railway) ---
DATA_DIR=/data
MODE=polling
WEBHOOK_URL=

# --- Real Hermes dashboard auth (basic provider, public bind) ---
DASHBOARD_USER=admin
DASHBOARD_PASS=changeme

# --- opencode Zen auth: single-line content of ~/.local/share/opencode/auth.json ---
OPENCODE_AUTH_JSON=

# --- Workers ---
TZ=Asia/Tehran
